    type(text: string): number {
      return this.host.typeInto((s) => (this.input = s), text);
    }

    submit(prompt: string, title: string, verb: string) {
      this.input = '';
      this.push({ k: 'user', text: prompt });
      this.agent.msg = title;
      this.start(verb);
    }
  }

  interface Win {
    idx: number; // tmux window index; closing a window leaves a gap
    name: string;
    kind: 'shell' | 'config' | 'task';
    agent?: Agent;
    cc?: Claude;
    side?: { lines: Line[]; cmd: string };
    seen: boolean;
  }

  class LiveTmux extends HTMLElement {
    t = 0;
    timer = 0;
    visible = false;
    rows: HTMLDivElement[] = [];
    // Each row's panes as last drawn, so a frame rewrites only the panes
    // that changed.
    cache: string[][] = [];
    io?: IntersectionObserver;
    queue: { at: number; fn: () => void }[] = [];
    grouped: Line[] = [];
    agents: Agent[] = [];
    wins: Win[] = [];
    cur = 1;
    last = 2;
    sh = { lines: [] as Line[], input: '', cmd: 'zsh', busy: false };
    // Pointer position in cells (x = column, y = row) along a curved path.
    mouse = {
      x: 70,
      y: 18,
      sx: 70,
      sy: 18,
      cx: 70,
      cy: 18,
      tx: 70,
      ty: 18,
      t0: 0,
      dur: 0,
      on: false,
      down: false,
    };
    hint = { on: false, x: 0, y: 0, shown: false };
    tileRows = new Map<Agent, number>();
    // Typing rhythm and pointer jitter come from a seeded generator, so every
    // loop runs to the same length and the chapter bar can be measured once.
    seed = 1;
    loopT0 = 0;
    loops = 0;
    marks: number[] = [];
    total = 0;
    chapterEls: HTMLElement[] = [];
    timeEl?: HTMLElement;
    caption = '';
    capEl?: HTMLElement;
    capShown = '';
    pointer?: HTMLElement;
    hintEl?: HTMLElement;
    drawn = '';
    // Set at the moment that best stands for the whole loop, the frame shown
    // when motion is reduced.
    poster = false;
    onVis = () => this.sync();

    connectedCallback() {
      const grid = this.querySelector('.lt-grid')!;
      this.rows = [...grid.querySelectorAll<HTMLDivElement>(':scope > .r')];
      this.pointer = document.createElement('div');
      this.pointer.className = 'lt-mouse';
      this.pointer.innerHTML = POINTER;
      this.hintEl = document.createElement('div');
      this.hintEl.className = 'lt-hint';
      this.hintEl.textContent = 'yes, the mouse works too';
      grid.append(this.pointer, this.hintEl);
      this.fitFont(grid as HTMLElement);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        for (const el of this.querySelectorAll<HTMLElement>(
          '.lt-cap, .lt-chapters, .lt-time',
        ))
          el.hidden = true;
        this.reset();
        while (!this.poster && this.t < 120000) this.tick(false);
        this.paint();
        return;
      }
      this.measure();
      this.buildBar();
      this.reset();
      this.paint();
      this.io = new IntersectionObserver(([e]) => {
        this.visible = e.isIntersecting;
        this.sync();
      });
      this.io.observe(this);
      document.addEventListener('visibilitychange', this.onVis);
    }

    // Play one loop without drawing to learn where each chapter starts and how
    // long the whole loop runs.
    measure() {
      this.reset();
      const n = this.loops;
      const t0 = this.t;
      while (this.loops === n && this.t - t0 < 180000) this.tick(false);
      this.total = this.t - t0;
    }

    buildBar() {
      this.capEl = this.querySelector<HTMLElement>('.lt-cap')!;
      const box = this.querySelector('.lt-chapters')!;
      this.timeEl = this.querySelector<HTMLElement>('.lt-time')!;
      this.chapterEls = CHAPTERS.map((label, i) => {
        const end = this.marks[i + 1] ?? this.total;
        const b = document.createElement('button');
        b.className = 'lt-ch';
        b.type = 'button';
        b.style.setProperty('--w', String(end - this.marks[i]));
        b.innerHTML = '<i></i>';
        b.title = label;
        b.setAttribute('aria-label', `Jump to ${label}`);
        // A pointer click seeks to the point under it; keyboard activation
        // (detail 0) jumps to the chapter's start.
        b.addEventListener('click', (e) => {
          const r = b.getBoundingClientRect();
          const f = e.detail
            ? Math.max(0, Math.min(1, (e.clientX - r.left) / r.width))
            : 0;
          this.seek(this.marks[i] + f * (end - this.marks[i]));
        });
        box.append(b);
        return b;
      });
    }

    // Jump to a point in the loop by replaying it from the start undrawn.
    seek(ms: number) {
      this.reset();
      while (this.t - this.loopT0 < ms) this.tick(false);
      this.paint();
    }

    // Caption text; `backticks` mark commands.
    say(text: string) {
      this.caption = text;
    }

    drawCaption() {
      const box = this.capEl;
      if (!box || this.capShown === this.caption) return;
      this.capShown = this.caption;
      for (const old of box.querySelectorAll('span:not([data-out])')) {
        old.setAttribute('data-out', '');
        setTimeout(() => old.remove(), 260);
      }
      if (!this.caption) return;
      const span = document.createElement('span');
      this.caption.split('`').forEach((part, i) => {
        if (!part) return;
        if (i % 2) {
          const c = document.createElement('code');
          c.textContent = part;
          span.append(c);
        } else span.append(part);
      });
      box.append(span);
    }

    mark(i: number) {
      this.marks[i] = this.t - this.loopT0;
    }

    rand(): number {
      this.seed = (this.seed * 16807) % 2147483647;
      return (this.seed - 1) / 2147483646;
    }

    drawBar() {
      if (!this.timeEl) return;
      const el = Math.min(this.t - this.loopT0, this.total);
      this.chapterEls.forEach((b, i) => {
        const start = this.marks[i];
        const end = this.marks[i + 1] ?? this.total;
        const p = Math.max(0, Math.min(1, (el - start) / (end - start)));
        b.style.setProperty('--p', `${(p * 100).toFixed(1)}%`);
        b.toggleAttribute('data-on', el >= start && el < end);
      });
      const text = `${fmtClock(el)} / ${fmtClock(this.total)}`;
      if (this.timeEl.textContent !== text) this.timeEl.textContent = text;
    }

    // Measure the advance width once the font is in, so the grid fills the
    // frame exactly.
    fitFont(grid: HTMLElement) {
      const family = FONT_FAMILY;
      const measure = () => {
        const probe = document.createElement('span');
        probe.textContent = '0'.repeat(100);
        probe.style.cssText =
          'position:absolute;visibility:hidden;font-size:100px;line-height:1';
        grid.append(probe);
        const adv = probe.getBoundingClientRect().width / 10000;
        probe.remove();
        if (adv > 0) grid.style.setProperty('--adv', adv.toFixed(4));
      };
      measure();
      Promise.all(
        [
          `16px "${family}"`,
          `bold 16px "${family}"`,
          `italic 16px "${family}"`,
        ].map((f) => document.fonts.load(f)),
      ).then(measure, () => {});
    }

    disconnectedCallback() {
      this.io?.disconnect();
      document.removeEventListener('visibilitychange', this.onVis);
      clearInterval(this.timer);
      this.timer = 0;
    }

    sync() {
      const run = this.visible && !document.hidden;
      if (run && !this.timer)
        this.timer = window.setInterval(() => this.tick(), STEP);
      if (!run && this.timer) {
        clearInterval(this.timer);
        this.timer = 0;
      }
    }

    reset() {
      const t = this.t;
      this.queue = [];
      this.seed = 1;
      this.loopT0 = t;
      this.loops++;
      this.mark(0);
      this.say('Start a task from your main checkout with `workmux add`');
      const work = (
        ph: Phase[],
        loopFrom = 1,
      ): Pick<Agent, 'cycle' | 'loopFrom' | 'phase' | 'phaseEnd'> => ({
        cycle: ph,
        loopFrom,
        phase: 0,
        phaseEnd: t + ph[0].dur,
      });
      this.agents = [
        {
          name: 'agents-config',
          proj: 'workmux',
          st: 'work',
          since: t - 110000,
          add: 46,
          del: 11,
          uadd: 28,
          udel: 3,
          msg: 'Adding per-agent config overrides',
        },
        {
          name: 'opencode',
          proj: 'consult-llm',
          st: 'work',
          since: t - 152000,
          add: 0,
          del: 0,
          uadd: 127,
          udel: 23,
          msg: 'Adding opencode backend support',
          ...work([
            { st: 'work', dur: 16000 },
            { st: 'wait', msg: 'Keep the v1 session fallback?', dur: 13000 },
            { st: 'work', msg: 'Wiring opencode session resume', dur: 26000 },
            { st: 'wait', msg: 'Run the integration suite now?', dur: 12000 },
            { st: 'work', msg: 'Adding opencode backend support', dur: 24000 },
          ]),
        },
        {
          name: 'batch-processing',
          proj: 'anki-llm',
          st: 'wait',
          since: t - 370000,
          add: 0,
          del: 0,
          uadd: 0,
          udel: 0,
          msg: 'Refactoring queue handler',
          ...work([
            { st: 'wait', dur: 8000 },
            { st: 'work', msg: 'Refactoring queue handler', dur: 21000 },
            { st: 'done', msg: 'Queue handler refactored', dur: 24000 },
            { st: 'work', msg: 'Adding retry with backoff', dur: 22000 },
            { st: 'wait', msg: 'Retry failed jobs on startup?', dur: 14000 },
          ]),
        },
        {
          name: 'auto-layout',
          proj: 'workmux',
          st: 'done',
          since: t - 545000,
          add: 318,
          del: 87,
          uadd: 0,
          udel: 0,
          msg: 'Implementing automatic layout',
        },
        {
          name: 'history-filter',
          proj: 'consult-llm',
          st: 'idle',
          since: t - 3700000,
          add: 153,
          del: 41,
          uadd: 0,
          udel: 0,
          msg: 'Adding date range filter',
        },
        {
          name: 'bluetooth-reconnect',
          proj: 'WalkingMate',
          st: 'idle',
          since: t - 3900000,
          add: 0,
          del: 0,
          uadd: 0,
          udel: 0,
          msg: 'Auto-reconnect on disconnect',
        },
        // The worktree building this very demo.
        {
          name: 'live-tmux-demo',
          proj: 'workmux',
          st: 'work',
          since: t - 64000,
          add: 0,
          del: 0,
          uadd: 212,
          udel: 38,
          msg: 'Editing this',
          ...work(
            [
              { st: 'work', msg: 'Editing this', dur: 27000 },
              { st: 'wait', msg: 'Like this?', dur: 11000 },
              { st: 'work', msg: 'Adding a tile', dur: 30000 },
            ],
            0,
          ),
        },
        {
          name: 'step-goal-sync',
          proj: 'WalkingMate',
          st: 'idle',
          since: t - 2 * 86400000,
          add: 0,
          del: 0,
          uadd: 0,
          udel: 0,
          msg: 'Sync step goals to watch',
        },
      ];
      const by = (name: string) => this.agents.find((a) => a.name === name)!;

      const cfg = new Claude(this, by('agents-config'));
      cfg.blocks = [
        ...HISTORY,
        {
          k: 'dim',
          text: 'Searched for 1 pattern, read 1 file (ctrl+o to expand)',
        },
        {
          k: 'msg',
          text: "`src/skills.rs` still keeps a hardcoded agent list. I'll switch it to `Agent::ALL` so new agents get their skills automatically.",
        },
        {
          k: 'tool',
          name: 'Update',
          arg: 'src/skills.rs',
          st: 'ok',
          out: updated('src/skills.rs', 1, 2, DIFF_ALL),
        },
        {
          k: 'tool',
          name: 'Bash',
          arg: 'just check 2>&1',
          st: 'ok',
          out: textOut(
            'test result: ok. 830 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 1.07s',
          ),
        },
        {
          k: 'msg',
          text: 'All 830 tests pass. `install_skills` now iterates `Agent::ALL`, so adding an agent no longer means touching the installer.',
        },
        { k: 'worked', text: 'Worked for 1m 25s' },
      ];
      cfg.agent.st = 'done';
      cfg.agent.msg = 'Skills follow Agent::ALL';
      cfg.agent.since = t - 95000;

      this.wins = [
        { idx: 1, name: 'main', kind: 'shell', seen: true },
        {
          idx: 2,
          name: 'agents-config',
          kind: 'config',
          agent: cfg.agent,
          cc: cfg,
          seen: false,
        },
        {
          idx: 3,
          name: 'auto-layout',
          kind: 'task',
          agent: by('auto-layout'),
          seen: true,
        },
      ];
      this.cur = 0;
      this.last = 1;
      this.poster = false;
      this.mouse.on = this.mouse.down = false;
      this.hint.on = this.hint.shown = false;
      this.sh = {
        lines: [
          PROMPT_TOP,
          shellCmd('git pull'),
          [['Already up to date.', 't']],
          [],
        ],
        input: '',
        cmd: 'zsh',
        busy: false,
      };
      this.play(this.scenario(cfg));
    }

    // ------------------------------------------------------- scheduling

    later(ms: number, fn: () => void) {
      this.queue.push({ at: this.t + ms, fn });
      this.queue.sort((a, b) => a.at - b.at);
    }

    play(steps: Step[], then?: () => void) {
      const next = (i: number) => {
        if (i >= steps.length) return then?.();
        const [delay, fn] = steps[i];
        this.later(delay, () => {
          const extra = fn() || 0;
          if (extra) this.later(extra, () => next(i + 1));
          else next(i + 1);
        });
      };
      next(0);
    }

    tick(draw = true) {
      this.t += STEP;
      while (this.queue.length && this.queue[0].at <= this.t)
        this.queue.shift()!.fn();
      for (const w of this.wins)
        if (w.cc?.spin.on)
          w.cc.spin.tokens += ((6 + Math.random() * 22) * STEP) / TICK;
      for (const a of this.agents) this.advance(a);
      this.stepMouse();
      if (draw) this.paint();
    }

    advance(a: Agent) {
      if (a.cycle && this.t >= a.phaseEnd!) {
        a.phase = a.phase! + 1 >= a.cycle.length ? a.loopFrom! : a.phase! + 1;
        const ph = a.cycle[a.phase];
        a.st = ph.st;
        if (ph.msg) a.msg = ph.msg;
        a.since = this.t;
        a.phaseEnd = this.t + ph.dur;
      }
      if (a.cycle && a.st === 'work' && this.t >= (a.nextEdit ?? 0)) {
        a.nextEdit = this.t + 2500 + Math.random() * 3500;
        if (this.t > 0) {
          a.uadd += 1 + Math.floor(Math.random() * 9);
          a.udel += Math.floor(Math.random() * 3);
        }
      }
    }

    setState(a: Agent, st: State) {
      a.st = st;
      a.since = this.t;
      const w = this.wins.find((w) => w.agent === a);
      if (w && st === 'done') w.seen = false;
    }

    // tmux select-window: the last window is what `-` marks in the status bar.
    go(i: number) {
      if (i === this.cur) return;
      this.last = this.cur;
      this.cur = i;
      this.wins[i].seen = true;
    }

    // Glide the pointer to a cell along a slight arc; returns the duration.
    moveTo(x: number, y: number): number {
      const m = this.mouse;
      if (!m.on) {
        m.x = 74;
        m.y = 20;
        m.on = true;
      }
      const dx = x - m.x;
      const dy = (y - m.y) * 2.6;
      const dist = Math.hypot(dx, dy);
      const dur = Math.round(Math.min(1300, 520 + dist * 6.5) / STEP) * STEP;
      // Bow the path to one side, as a wrist pivot does.
      const bow = 0.18 * dist;
      Object.assign(m, {
        sx: m.x,
        sy: m.y,
        tx: x,
        ty: y,
        cx: (m.x + x) / 2 + (dy / dist) * bow,
        cy: (m.y + y) / 2 - ((dx / dist) * bow) / 2.6,
        t0: this.t,
        dur,
      });
      return dur + 180;
    }

    // Point at an agent's tile in the sidebar.
    moveToAgent(a: Agent): number {
      this.groupedSidebar(Math.floor(this.t / TICK));
      const row = this.tileRows.get(a) ?? 1;
      return this.moveTo(13 + this.rand() * 4, row + 0.55);
    }

    press(then: () => void, hint = false): number {
      const m = this.mouse;
      m.down = true;
      this.later(130, () => {
        m.down = false;
        then();
        if (hint && !this.hint.shown) {
          Object.assign(this.hint, {
            on: true,
            shown: true,
            x: m.x - 6,
            y: m.y + 2.3,
          });
          this.later(2800, () => (this.hint.on = false));
        }
      });
      return 130;
    }

    stepMouse() {
      const m = this.mouse;
      if (!m.dur || this.t > m.t0 + m.dur + STEP) return;
      const p = easeMove(Math.min(1, (this.t - m.t0) / m.dur));
      const u = 1 - p;
      m.x = u * u * m.sx + 2 * u * p * m.cx + p * p * m.tx;
      m.y = u * u * m.sy + 2 * u * p * m.cy + p * p * m.ty;
    }

    drawMouse() {
      const m = this.mouse;
      const h = this.hint;
      const key = `${m.x.toFixed(2)},${m.y.toFixed(2)},${m.on},${m.down},${h.on}`;
      if (key === this.drawn || !this.pointer || !this.hintEl) return;
      this.drawn = key;
      this.pointer.style.transform = `translate(${m.x}ch, ${m.y * 2.6}ch)`;
      this.pointer.toggleAttribute('data-on', m.on);
      this.pointer.toggleAttribute('data-down', m.down);
      this.hintEl.style.setProperty('--x', `${h.x}ch`);
      this.hintEl.style.setProperty('--y', `${h.y * 2.6}ch`);
      this.hintEl.toggleAttribute('data-on', h.on);
    }

    typeInto(set: (s: string) => void, text: string): number {
      // macOS hides the pointer once you start typing.
      this.later(60, () => (this.mouse.on = false));
      let at = 0;
      for (let i = 1; i <= text.length; i++) {
        at += 22 + this.rand() * 38;
        this.later(at, () => set(text.slice(0, i)));
      }
      return at + 350;
    }

    // A window created by `workmux add`: the agent starts on its prompt
    // beside the setup pane from .workmux.yaml.
    // Without a prompt the agent sits at an empty input with no status yet.
    spawn(name: string, prompt: string | null, msg: string, verb: string): Win {
      const a: Agent = {
        name,
        proj: 'workmux',
        st: 'new',
        since: this.t,
        add: 0,
        del: 0,
        uadd: 0,
        udel: 0,
        msg,
        cycle: [{ st: 'work', dur: 600000 }],
        loopFrom: 0,
        phase: 0,
        phaseEnd: this.t + 600000,
        nextEdit: this.t + 4000,
      };
      this.agents.push(a);
      const cc = new Claude(this, a);
      if (prompt !== null) {
        cc.push({ k: 'user', text: prompt });
        cc.start(verb);
      }
      const side = { lines: [] as Line[], cmd: 'bun' };
      const idx = Math.max(...this.wins.map((w) => w.idx)) + 1;
      const w: Win = {
        idx,
        name,
        kind: 'task',
        agent: a,
        cc,
        side,
        seen: true,
      };
      this.wins.push(w);
      this.play(
        BUN.map(([d, l]): Step => [d, () => void side.lines.push(l)]),
        () =>
          this.later(400, () => {
            side.cmd = 'zsh';
            side.lines.push(
              [],
              [
                [`~/code/workmux__worktrees/${name}`, 'shp'],
                [` ${name}`, 'shb'],
              ],
              [['❯', 'shc']],
            );
          }),
      );
      return w;
    }

    // The window and its agent go away, as after `workmux merge`; tmux falls
    // back to the last window.
    despawn(w: Win) {
      const i = this.wins.indexOf(w);
      const last = this.wins[this.last];
      this.wins.splice(i, 1);
      this.agents = this.agents.filter((a) => a !== w.agent);
      const to = last && last !== w ? this.wins.indexOf(last) : 0;
      this.cur = to;
      this.last = to === 0 ? 1 : 0;
      this.wins[to].seen = true;
    }

    // ------------------------------------------------------------ story

    scenario(cfg: Claude): Step[] {
      let flaky: Win;
      let kitty: Win;
      let w1: ToolBlock;
      let w2: ToolBlock;
      let cur: ToolBlock;
      const sh = this.sh;
      const ADD = 'workmux add fix-flaky-tests';
      const FIX =
        'The sidebar snapshot test fails now and then on CI. Find out why and make it deterministic.';
      const idxOf = (w: Win) => this.wins.indexOf(w);
      return [
        // 1. From the main checkout, open a worktree with `workmux add` and
        // brief its agent there.
        [1400, () => this.typeInto((s) => (sh.input = s), ADD)],
        [
          0,
          () => {
            sh.lines.push(PROMPT_TOP, shellCmd(ADD));
            sh.input = '';
            sh.busy = true;
            sh.cmd = 'workmux';
          },
        ],
        [500, () => void sh.lines.push([['Running setup commands...', 't']])],
        [
          800,
          () =>
            void sh.lines.push([
              ['✓ ', 'ok'],
              ['Setup complete', 't'],
            ]),
        ],
        [
          300,
          () => {
            // Until the first prompt the tile shows the agent's pane title.
            flaky = this.spawn('fix-flaky-tests', null, 'claude', '');
            this.go(idxOf(flaky));
            this.say(
              'It gets its own worktree and window, with the agent and setup commands',
            );
            sh.lines.push(
              [
                ['✓ ', 'ok'],
                [
                  "Successfully created worktree and tmux window for 'fix-flaky-tests'",
                  't',
                ],
              ],
              [['  Base: main', 't']],
              [
                [
                  '  Worktree: /Users/you/code/workmux__worktrees/fix-flaky-tests',
                  't',
                ],
              ],
              [],
            );
            sh.busy = false;
            sh.cmd = 'zsh';
          },
        ],

        [1100, () => flaky.cc!.type(FIX)],
        [
          0,
          () => {
            flaky.cc!.submit(
              FIX,
              'Fixing flaky snapshot test',
              'Investigating',
            );
            this.say('Prompt the agent and get on with something else');
            this.play(this.flaky(flaky.cc!));
          },
        ],

        // 2. Leave it working; hand two more tasks to an agent's /worktree skill.
        [
          5000,
          () => {
            this.mark(1);
            this.go(1);
            this.say(
              'Or let an agent hand off tasks with the `/worktree` skill',
            );
          },
        ],
        [900, () => cfg.type(DISPATCH)],
        [
          0,
          () =>
            cfg.submit(DISPATCH, 'Dispatching two worktrees', 'Orchestrating'),
        ],
        [
          1200,
          () => {
            w1 = cfg.tool(
              'Bash',
              'tmpfile=$(mktemp).md && cat > "$tmpfile" <<\'EOF\'…',
            );
            w2 = cfg.tool(
              'Bash',
              'tmpfile=$(mktemp).md && cat > "$tmpfile" <<\'EOF\'…',
            );
          },
        ],
        [
          700,
          () => {
