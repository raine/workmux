    // ---------------------------------------------------------- drawing

    blink() {
      return Math.floor(this.t / 500) % 2 === 0;
    }

    blockLines(b: Block): Line[] {
      const bullet = (cls: string): Seg => ['●', cls];
      const runBullet = (): Seg => (this.blink() ? bullet('d') : [' ', '']);
      switch (b.k) {
        case 'raw':
          return b.lines;
        case 'msg':
          return wrap(b.text, TEXT_W).map((l, i) => [
            i ? sp(2) : bullet('w'),
            ...(i ? [] : [sp(1)]),
            ...l,
          ]);
        case 'dim':
          return [[sp(2), [b.text, 'd']]];
        case 'worked':
          return [
            [
              ['✻ ', 'd'],
              [b.text, 'd'],
            ],
          ];
        case 'user':
          return wrapPlain(b.text, AG - 3).map((l, i): Line => [
            [(i ? '  ' : '> ') + l.padEnd(AG - 3), 'up Bup'],
          ]);
        case 'search':
          return b.st === 'run'
            ? [
                [
                  runBullet(),
                  sp(1),
                  [b.run, 'w'],
                  [' (ctrl+o to expand)', 'd'],
                ],
                [
                  ['  ⎿  ', 'd'],
                  [b.file, 't'],
                ],
              ]
            : [[sp(2), [`${b.ok} (ctrl+o to expand)`, 'd']]];
        case 'tool':
          return [
            [
              b.st === 'run' ? runBullet() : bullet('ok'),
              sp(1),
              [b.name, 'b w'],
              [`(${b.arg})`, 't'],
            ],
            ...b.out.map((l, i): Line => [[i ? '     ' : '  ⎿  ', 'd'], ...l]),
          ];
      }
    }

    transcript(cc: Claude): Line[] {
      const flat: Line[] = [];
      for (const b of cc.blocks) {
        if (flat.length) flat.push([]);
        flat.push(...this.blockLines(b));
      }
      flat.push([]);
      if (!cc.ask)
        return flat.slice(-(TRANSCRIPT_ROWS + 1 - this.inputLines(cc).length));
      // The question replaces the input box at the bottom of the pane.
      const q = cc.ask;
      flat.push(
        [sp(AG, 'hl lr')],
        [sp(1), [` ☐ ${q.head} `, 'up Bup']],
        [],
        ...wrapPlain(q.question, AG - 2).map((l): Line => [sp(1), [l, 'b w']]),
        [],
      );
      q.options.forEach(([label, desc], i) => {
        const sel = i === 0;
        flat.push(
          [
            [sel ? ' ❯ ' : '   ', 'code'],
            [`${i + 1}. ${label}`, sel ? (cc.choice ? 'code b' : 'code') : 't'],
          ],
          [[`      ${desc}`, 'd']],
        );
      });
      flat.push(
        [[`   ${q.options.length + 1}. Type something.`, 't']],
        [],
        [[' Enter to select · ↑/↓ to navigate · Esc to cancel', 'd']],
      );
      return flat.slice(-(ROWS - 3));
    }

    spinnerLine(cc: Claude): Line {
      const s = cc.spin;
      if (!s.on) return [];
      const frame = Math.floor(this.t / TICK);
      const glyph = SPIN_GLYPHS[frame % SPIN_GLYPHS.length];
      const hot = (frame % (s.verb.length + 12)) - 3;
      const verb: Line = [...s.verb].map((ch, i) => [
        ch,
        Math.abs(i - hot) <= 1 ? 'sv2' : 'sv',
      ]);
      return [
        [glyph, 'sg'],
        sp(1),
        ...verb,
        ['…', 'sv'],
        [` (${fmtDur(this.t - s.start)} · ↓ ${fmtTok(s.tokens)} tokens)`, 'd'],
      ];
    }

    // The input box wraps its text and grows upward, taking rows from the
    // transcript.
    inputLines(cc: Claude): Line[] {
      const rows = wrapPlain(cc.input, AG - 3);
      if (!rows.length) rows.push('');
      return rows.map((l, i): Line => [
        [i ? '  ' : '❯ ', 'd'],
        [l, 't'],
        ...(i === rows.length - 1 ? [[' ', 'Bcur'] as Seg] : []),
      ]);
    }

    // The agent pane from its first row down: the transcript's tail, then
    // the spinner and input box, or the question in their place.
    agentLines(cc: Claude): Line[] {
      const tr = this.transcript(cc);
      if (cc.ask) return tr;
      const input = this.inputLines(cc);
      const top = TRANSCRIPT_ROWS + 1 - input.length;
      return [
        ...Array.from({ length: top }, (_, i) => tr[i] ?? []),
        this.spinnerLine(cc),
        [],
        [sp(AG, 'hl lr')],
        ...input,
        [sp(AG, 'hl lr')],
        [sp(2), [cc.spin.on ? 'esc to interrupt' : '? for shortcuts', 'd']],
      ];
    }

    // The shell pane from its first row down.
    shellLines(): Line[] {
      const sh = this.sh;
      const input: Line = [
        ...(sh.input ? shellCmd(sh.input) : shellCmd('').slice(0, 1)),
        [' ', 'Bcur'],
      ];
      const lines: Line[] = sh.busy
        ? sh.lines
        : [...sh.lines, PROMPT_TOP, input];
      return lines.slice(-(ROWS - 2));
    }

    tileRow(a: Agent, k: number, frame: number, sel: boolean): Line {
      const idle = a.st === 'idle';
      const fresh = a.st === 'new';
      const W = SB - 6; // text spans cols 5-28
      const lead: Line = [sp(1, `bar ${BAR[a.st]}`)];
      if (k === 0) {
        const icon: Seg = a.st === 'work' ? [spinner(frame), 'sk'] : ICON[a.st];
        const time = ago(this.t - a.since);
        const name = clip(a.name, W - time.length - 1);
        const nameCls = idle ? 'si' : sel ? 'sn b' : 'sn';
        return [
          ...lead,
          sp(1),
          icon,
          sp(1),
          [name, nameCls],
          sp(W - strW(name) - time.length),
          [time, idle ? 'si' : fresh ? 'sm' : 'stm'],
          sp(1),
        ];
      }
      const diff: Line = [];
      if (a.add || a.del)
        diff.push([`+${a.add}`, idle ? 'si' : 'sa'], sp(1), [
          `-${a.del}`,
          idle ? 'si' : 'sd',
        ]);
      if (a.uadd || a.udel) {
        if (diff.length) diff.push(sp(1));
        diff.push(
          { svg: 'pencil', cls: 'spn', w: 2 },
          [`+${a.uadd}`, 'sa2'],
          sp(1),
          [`-${a.udel}`, 'sd2'],
        );
      }
      const dw = lineW(diff);
      // The second line leaves out the project, which the group header
      // already names, and shows the pane title beside the diff instead.
      const left = clip(a.msg, W - dw - (dw ? 1 : 0));
      return [
        ...lead,
        sp(4),
        [left, idle ? 'si' : 'sm'],
        sp(W - strW(left) - dw),
        ...diff,
        sp(1),
      ];
    }

    // Sidebar grouped by project: banded headers, live agents as two-line
    // tiles, stale agents folded into a tail or, for groups with nothing live,
    // listed one line each under a STALE rule.
    groupedSidebar(frame: number): Line[] {
      const by = (name: string) => this.agents.find((a) => a.name === name)!;
      const sel = this.wins[this.cur].agent;
      const div: Line = [sp(SB, 'hl lsep')];
      const header = (label: string, count: number, chevron = ''): Line => {
        const cnt = String(count);
        const lead: Line = chevron
          ? [[`${chevron} `, 'sst Bband']]
          : [sp(2, 'Bband')];
        return [
          ...lead,
          [label, 'gh b Bband'],
          sp(SB - 3 - label.length - cnt.length, 'Bband'),
          [cnt, 'sp Bband'],
          sp(1, 'Bband'),
        ];
      };
      const tile = (a: Agent) =>
        [0, 1].map((k) =>
          fit(
            this.tileRow(a, k, frame, a === sel),
            SB,
            a === sel ? 'Bsel' : '',
          ),
        );
      const dormant = (a: Agent): Line => {
        const time = ago(this.t - a.since);
        const W = SB - 6;
        const name = clip(a.name, W - time.length - 1);
        return [
          sp(1, 'bar bi'),
          sp(1),
          { svg: 'nfSleep', cls: 'sst', w: 2 },
          sp(1),
          [name, 'sst'],
          sp(W - strW(name) - time.length),
          [time, 'sst'],
          sp(1),
        ];
      };
      const rule = (label: string): Line => {
        const text = ` ${label} `;
        const left = Math.floor((SB - text.length) / 2);
        return [
          sp(left, 'hl lsep'),
          [text, 'sp'],
          sp(SB - text.length - left, 'hl lsep'),
        ];
      };
      const wm = this.agents.filter((a) => a.proj === 'workmux');

      // Screen row of each tile's first line, for pointing at it.
      const lines: Line[] = [];
      this.tileRows.clear();
      const add = (...ls: Line[]) => void lines.push(...ls);
      const addTile = (a: Agent) => {
        this.tileRows.set(a, lines.length + 1);
        add(...tile(a));
      };

      add(header('workmux', wm.length));
      for (const a of wm) {
        addTile(a);
        add(div);
      }
      add(header('consult-llm', 2));
      addTile(by('opencode'));
      add(div, [['  ▸ 1 stale', 'sst']], div, header('anki-llm', 1));
      addTile(by('batch-processing'));
      add(
        rule('STALE'),
        header('WalkingMate', 2, '▾'),
        dormant(by('bluetooth-reconnect')),
        dormant(by('step-goal-sync')),
        div,
        header('aven', 4, '▸'),
      );
      return lines;
    }

    sidebarRow(r: number): Line {
      return this.grouped[r - 1] ?? [];
    }

    rightRow(r: number): Line {
      if (r <= 25) return NVIM[r - 1];
      if (r === 26) return NVIM_STATUS;
      if (r === 27) return [sp(RT, 'Bnv')];
      if (r === 28)
        return [
          sp(2, 'hl lg'),
          sp(1),
          ['3: just', 'tg'],
          sp(1),
          sp(RT - 11, 'hl lg'),
        ];
      return VITE[r - 29] ?? [];
    }

    sideRow(w: Win, r: number): Line {
      const l = w.side?.lines[r - 1];
      return l ? [sp(1), ...l] : [];
    }

    paneTitle(w: number, label: string, active: boolean): Line {
      const l = active ? 'hl la' : 'hl lg';
      return [
        sp(2, l),
        sp(1),
        [label, active ? 'ta' : 'tg'],
        sp(1),
        sp(w - label.length - 4, l),
      ];
    }

    winIcon(w: Win, active: boolean): string {
      const st = w.agent?.st;
      if (st === 'work') return '🤖';
      if (st === 'wait') return '💬';
      if (st === 'done' && (active || !w.seen)) return '✅';
      return '';
    }

    statusBar(): Line {
      const d = new Date();
      const p = (n: number) => String(n).padStart(2, '0');
      const clock = `${p(d.getDate())}.${p(d.getMonth() + 1)}. ${p(d.getHours())}:${p(d.getMinutes())}`;
      const left: Line = [['workmux', 'stl']];
      this.wins.forEach((w, i) => {
        const active = i === this.cur;
        const icon = this.winIcon(w, active);
        const flag = active ? '*' : i === this.last ? '-' : '';
        const c = active ? 'wa Bwa' : 'stw';
        left.push(sp(active || i - 1 === this.cur ? 1 : 2));
        if (w.kind === 'shell') {
          left.push([`${w.idx}:${w.name}${flag}`, c]);
          return;
        }
        left.push([`${w.idx}:`, c], { svg: 'branch', cls: c }, [
          ` ${w.name}`,
          c,
        ]);
        if (icon) left.push([' ', c], [icon, active ? 'Bwa' : '']);
        left.push([flag, c]);
      });
      return spread(left, [[clock, 'clk']], COLS, '');
    }

    paint() {
      // Lets the page label the panes of whichever window is showing.
      const kind = this.wins[this.cur].kind;
      if (this.dataset.win !== kind) this.dataset.win = kind;
      this.drawBar();
      this.drawCaption();
      const frame = Math.floor(this.t / TICK);
      const w = this.wins[this.cur];
      const agent = w.cc ? this.agentLines(w.cc) : [];
      const shell = w.kind === 'shell' ? this.shellLines() : [];
      this.grouped = this.groupedSidebar(frame);
      for (let r = 0; r < ROWS; r++) {
        // Each pane is its own fixed-width box, so sub-pixel rounding inside
        // one pane never shifts the borders from row to row.
        let panes: [Line, number][];
        if (r === ROWS - 1) {
          panes = [[this.statusBar(), COLS]];
        } else if (w.kind === 'shell') {
          panes =
            r === 0
              ? [
                  [this.paneTitle(SB, '0: workmux', false), SB],
                  [[sp(1, 'ctd la')], 1],
                  [this.paneTitle(MAIN_W, `1: ${this.sh.cmd}`, true), MAIN_W],
                ]
              : [
                  [fit(this.sidebarRow(r), SB), SB],
                  [[sp(1, 'vl la')], 1],
                  [fit(shell[r - 1] ?? [], MAIN_W), MAIN_W],
                ];
        } else if (r === 0) {
          const right =
            w.kind === 'config' ? '2: nvim' : `2: ${w.side?.cmd ?? 'zsh'}`;
          panes = [
            [this.paneTitle(SB, '0: workmux', false), SB],
            [[sp(1, 'ctd la')], 1],
            [this.paneTitle(AG, '1: claude', true), AG],
            [[sp(1, 'ctd la')], 1],
            [this.paneTitle(RT, right, false), RT],
          ];
        } else {
          const cfg = w.kind === 'config';
          panes = [
            [fit(this.sidebarRow(r), SB), SB],
            [[sp(1, 'vl la')], 1],
            [fit(agent[r - 1] ?? [], AG, 'Bag'), AG],
            [[sp(1, cfg && r === 28 ? 'ctr la' : 'vl la')], 1],
            [fit(cfg ? this.rightRow(r) : this.sideRow(w, r), RT), RT],
          ];
        }
        const next = panes.map(
          ([line, w]) =>
            `<span class="rg" style="width:${w}ch">${html(fit(line, w))}</span>`,
        );
        const prev = this.cache[r];
        if (prev?.length === next.length) {
          const els = this.rows[r].children;
          next.forEach((h, i) => {
            if (h !== prev[i]) els[i].outerHTML = h;
          });
        } else {
          this.rows[r].innerHTML = next.join('');
        }
        this.cache[r] = next;
      }
      this.drawMouse();
    }
  }

  if (!customElements.get('live-tmux')) {
    customElements.define('live-tmux', LiveTmux);
  }
</script>
