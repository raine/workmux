---
// A live tmux session rendered as a character grid: the workmux sidebar,
// agent windows, and worktrees created with workmux add and /worktree.

// Rendered empty so the frame has its full height before the script runs;
// must match ROWS in the script.
const ROWS = 36;
---

<live-tmux class="lt">
  <div
    class="lt-grid"
    role="img"
    aria-label="A tmux session with the workmux sidebar: worktrees are created with workmux add and an agent's /worktree skill, an agent's question is answered from the sidebar, and finished work is merged with /merge, which closes its window"
  >
    {Array.from({ length: ROWS }, () => <div class="r" />)}
  </div>
  <div class="lt-cap" aria-hidden="true"></div>
  <div class="lt-chapters"></div>
  <span class="lt-time" aria-hidden="true"></span>
</live-tmux>

<style is:global>
  live-tmux {
    position: relative;
    display: block;
    container-type: inline-size;
    background: #111;
    color: #d4d4d4;
    cursor: default;
    user-select: none;
    -webkit-user-select: none;
  }

  /* The grid is 156 cells plus 1.25 cells of padding per side; --adv is the
     font's measured advance width in em, so the grid fills the frame and
     keeps the same cell aspect ratio. */
  live-tmux .lt-grid {
    position: relative;
    padding: 1.25ch;
    font-family: 'Iosevka Live', ui-monospace, Menlo, monospace;
    font-size: calc(100cqw / (158.5 * var(--adv, 0.5)));
    font-variant-ligatures: none;
    font-kerning: none;
    line-height: 2.6ch;
    white-space: pre;
    -webkit-font-smoothing: antialiased;
  }

  /* The pointer's tip sits at its box's top-left corner, placed in cell
     coordinates from the grid's padding edge. */
  /* What is happening right now, floating over the bottom of the session.
     The outgoing pill drifts up and fades while the next one rises in. */
  live-tmux .lt-cap {
    position: absolute;
    bottom: 5.3%;
    left: 0;
    right: 0;
    height: 2.5em;
    pointer-events: none;
    font:
      500 clamp(0.75rem, 1.15cqw, 0.9375rem) / 1 Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
  }

  live-tmux .lt-cap span {
    position: absolute;
    left: 50%;
    bottom: 0;
    padding: 0.75em 1.25em;
    border-radius: 999px;
    background: rgb(16 22 23 / 0.82);
    box-shadow:
      0 0 0 1px rgb(72 217 190 / 0.28) inset,
      0 12px 32px -8px rgb(0 0 0 / 0.7);
    -webkit-backdrop-filter: blur(10px) saturate(1.3);
    backdrop-filter: blur(10px) saturate(1.3);
    color: #eef4f2;
    white-space: nowrap;
    transform: translateX(-50%);
    animation: lt-cap-in 420ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  live-tmux .lt-cap span[data-out] {
    animation: lt-cap-out 240ms ease-out both;
  }

  live-tmux .lt-cap code {
    color: #48d9be;
    font-family: 'Iosevka Live', ui-monospace, Menlo, monospace;
    font-size: 1.05em;
  }

  @keyframes lt-cap-in {
    from {
      opacity: 0;
      transform: translate(-50%, 0.75em) scale(0.96);
      filter: blur(4px);
    }
  }

  @keyframes lt-cap-out {
    to {
      opacity: 0;
      transform: translate(-50%, -0.6em) scale(0.98);
      filter: blur(4px);
    }
  }

  /* Chapters of the loop as a thin line along the bottom edge, each segment
     as wide as the chapter is long. Segments seek on click. */
  live-tmux .lt-chapters {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    gap: 3px;
  }

  live-tmux .lt-ch {
    flex: var(--w) 1 0;
    height: 10px;
    padding: 7px 0 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  live-tmux .lt-ch i {
    display: block;
    height: 3px;
    background:
      linear-gradient(#48d9be, #48d9be) 0 0 / var(--p, 0%) 100% no-repeat,
      rgb(255 255 255 / 0.1);
    transition: height 160ms ease-out;
  }

  live-tmux .lt-ch:hover i {
    height: 5px;
    margin-top: -2px;
  }

  live-tmux .lt-time {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    background: rgb(17 17 17 / 0.85);
    color: #7a7a7a;
    font:
      500 0.6875rem/1 Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  live-tmux .lt-mouse {
    position: absolute;
    top: 1.25ch;
    left: 1.25ch;
    width: 2ch;
    height: 3.1ch;
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.45));
    transition: opacity 160ms ease-out;
    will-change: transform;
  }
  live-tmux .lt-mouse[data-on] {
    opacity: 1;
  }
  live-tmux .lt-mouse svg {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 0 0;
    transition: transform 90ms ease-out;
  }
  live-tmux .lt-mouse[data-down] svg {
    transform: scale(0.86);
  }

  live-tmux .lt-hint {
    position: absolute;
    top: 1.25ch;
    left: 1.25ch;
    padding: 0.35em 0.7em;
    border-radius: 0.5em;
    background: #48d9be;
    color: #06201b;
    font:
      600 clamp(10px, 1.1cqw, 13px) / 1.2 Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    letter-spacing: -0.01em;
    white-space: nowrap;
    box-shadow: 0 6px 18px -6px rgb(0 0 0 / 0.6);
    opacity: 0;
    pointer-events: none;
    transform: translate(var(--x), var(--y)) rotate(-4deg) scale(0.9);
    transform-origin: 0 50%;
    transition:
      opacity 200ms ease-out,
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  live-tmux .lt-hint[data-on] {
    opacity: 1;
    transform: translate(var(--x), var(--y)) rotate(-4deg);
  }

  /* Each row repaints on its own, so a changed row never invalidates its
     neighbours. */
  live-tmux .r {
    height: 2.6ch;
    overflow: hidden;
    contain: strict;
