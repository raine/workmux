  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const cw = (ch: string) => {
    const c = ch.codePointAt(0)!;
    return c >= 0x1f000 || c === 0x2705 ? 2 : 1;
  };
  // Text that is all ASCII is one cell per character.
  const ASCII = /^[\x00-\x7f]*$/;
  const strW = (s: string) => {
    if (ASCII.test(s)) return s.length;
    let n = 0;
    for (const ch of s) n += cw(ch);
    return n;
  };
  const segW = (s: Seg) => (Array.isArray(s) ? strW(s[0]) : (s.w ?? 1));
  const lineW = (l: Line) => l.reduce((n, s) => n + segW(s), 0);
  const sp = (n: number, cls = ''): Seg => [' '.repeat(Math.max(0, n)), cls];
  const hasBg = (cls: string) => /(^| )B/.test(cls);

  // Clip or pad a line to exactly `width` cells, painting `bg` where no
  // segment sets its own background.
  function fit(line: Line, width: number, bg = ''): Line {
    const out: Line = [];
    let used = 0;
    const add = (cls: string) => (bg && !hasBg(cls) ? `${cls} ${bg}` : cls);
    for (const s of line) {
      if (used >= width) break;
      if (!Array.isArray(s)) {
        const w = s.w ?? 1;
        if (used + w > width) break;
        out.push({ ...s, cls: add(s.cls) });
        used += w;
        continue;
      }
      if (used + s[0].length <= width && ASCII.test(s[0])) {
        if (s[0]) out.push([s[0], add(s[1])]);
        used += s[0].length;
        continue;
      }
      let txt = '';
      for (const ch of s[0]) {
        const w = cw(ch);
        if (used + w > width) break;
        txt += ch;
        used += w;
      }
      if (txt) out.push([txt, add(s[1])]);
    }
    if (used < width) out.push(sp(width - used, bg));
    return out;
  }

  function html(line: Line): string {
    let out = '';
    let runCls = '';
    let runTxt = '';
    let runW = 0;
    const flush = () => {
      if (runW)
        out += `<span class="${runCls}" style="width:${runW}ch">${esc(runTxt)}</span>`;
      runTxt = '';
      runW = 0;
    };
    for (const s of line) {
      if (!Array.isArray(s)) {
        flush();
        out += `<span class="${s.cls} g" style="width:${s.w ?? 1}ch">${SVG[s.svg]}</span>`;
        continue;
      }
      const [txt, cls] = s;
      if (ASCII.test(txt)) {
        if (!txt) continue;
        if (cls !== runCls) flush();
        runCls = cls;
        runTxt += txt;
        runW += txt.length;
        continue;
      }
      for (const ch of txt) {
        if (ch.codePointAt(0)! < 0x80) {
          if (cls !== runCls) flush();
          runCls = cls;
          runTxt += ch;
          runW++;
        } else {
          flush();
          const w = cw(ch);
          out += `<span class="${cls} g${w === 2 ? ' e' : ''}" style="width:${w}ch"><i>${ch}</i></span>`;
        }
      }
    }
    flush();
    return out;
  }

  // Greedy word wrap for text with `inline code` spans.
  function wrap(text: string, width: number): Line[] {
    const words: Seg[][] = [];
    text.split(/(`[^`]+`)/).forEach((part, i) => {
      const cls = i % 2 ? 'code' : 't';
      const body = i % 2 ? part.slice(1, -1) : part;
      body.split(/( )/).forEach((tok) => {
        if (tok === '') return;
        if (tok === ' ') words.push([]);
        else {
          if (!words.length) words.push([]);
          words[words.length - 1].push([tok, cls]);
        }
      });
    });
    const lines: Line[] = [];
    let cur: Line = [];
    let w = 0;
    for (const word of words) {
      if (!word.length) continue;
      const ww = lineW(word);
      if (w && w + 1 + ww > width) {
        lines.push(cur);
        cur = [];
        w = 0;
      }
      if (w) {
        cur.push([' ', 't']);
        w++;
      }
      cur.push(...word);
      w += ww;
    }
    if (cur.length) lines.push(cur);
    return lines;
  }

  function chop(text: string, width: number): string[] {
    const out: string[] = [];
    for (let i = 0; i < text.length; i += width)
      out.push(text.slice(i, i + width));
    return out;
  }

