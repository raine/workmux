  // Fast off the mark, long settle onto the target, the way a hand moves.
  const easeMove = (p: number) => {
    const k = 0.3; // share of the move spent accelerating
    if (p < k) return (0.5 * p * p) / k;
    const q = (p - k) / (1 - k);
    return 0.5 * k + (1 - 0.5 * k) * (1 - Math.pow(1 - q, 3));
