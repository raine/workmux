  class Claude {
    blocks: Block[] = [];
    spin: Spin = { on: false, verb: '', start: 0, tokens: 0 };
    input = '';
    // A pending question to the user; `choice` marks the answer as pressed.
    ask: {
      head: string;
      question: string;
      options: [string, string][];
    } | null = null;
    choice = false;
    constructor(
      public host: LiveTmux,
      public agent: Agent,
