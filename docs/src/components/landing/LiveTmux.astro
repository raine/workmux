  function rust(src: string, bg: string): Line {
    const c = src.indexOf('//');
    if (c >= 0)
      return [
        [src.slice(0, c), bg],
        [src.slice(c), `nc ${bg}`],
      ];
    const out: Line = [];
    const re =
      /(\s+)|('[^']*')|([A-Za-z_][A-Za-z0-9_]*)|(::|->|&&|[&!=.])|(.)/g;
    let m: RegExpExecArray | null;
    while ((m = re.exec(src))) {
      const [tok, ws, str, id, op] = m;
      const rest = src.slice(re.lastIndex);
      let cls = 'nf';
      if (ws) cls = '';
      else if (str) cls = 'nst';
      else if (op) cls = op === '::' || op === '.' ? 'nf' : 'no';
      else if (id) {
        if (id === 'use') cls = 'nu';
        else if (id === 'fn') cls = 'nk';
        else if (id === 'Self') cls = 'ns';
        else if (id === 'String' || id === 'str') cls = 'nt2';
        else if (ITALIC_KW.has(id)) cls = 'np';
        else if (VARIANTS.has(id)) cls = 'nv';
        else if (/^[A-Z]/.test(id)) cls = 'nt';
        else if (rest.startsWith('(')) cls = 'nfn';
        else if (/^: [A-Z]/.test(rest) && id.length > 1) cls = 'nfl';
        else if (rest.startsWith('::') || src.slice(0, m.index).endsWith('::'))
          cls = 'nm';
      }
      out.push([tok, cls ? `${cls} ${bg}` : bg]);
    }
    return out;
  }

