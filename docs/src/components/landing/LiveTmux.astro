    push<B extends Block>(b: B): B {
      this.blocks.push(b);
      if (this.blocks.length > 40)
        this.blocks.splice(0, this.blocks.length - 40);
      return b;
    }

    tool(name: string, arg: string, out: Line[] = []) {
      return this.push({ k: 'tool', name, arg, st: 'run', out } as ToolBlock);
    }

    start(verb: string) {
      this.spin = { on: true, verb, start: this.host.t, tokens: 0 };
      this.host.setState(this.agent, 'work');
