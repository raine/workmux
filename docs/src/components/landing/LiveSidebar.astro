---
// The workmux sidebar rendered live as a character grid beside an agent
// pane: agents changing status, then the compact layout, grouping by
// project, and the sidebar as a top bar.
import './grid.css';
---

<live-side class="gl">
  <div
    class="gl-grid"
    role="img"
    aria-label="A tmux window with the workmux sidebar: agents move between working, waiting and done, then the sidebar switches to its compact layout, groups agents by project, and moves to a bar along the top"
  >
  </div>
  <span class="gl-key" aria-hidden="true"></span>
  <div class="gl-chapters"></div>
  <span class="gl-time" aria-hidden="true"></span>
</live-side>

