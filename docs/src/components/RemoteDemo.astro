---
// The landing page's live remote servers demo, framed for a docs page.
import LiveRemote from './landing/LiveRemote.astro';
import './landing/fonts.css';

interface Props {
  caption?: string;
}

const { caption } = Astro.props;
---

<figure class="remote-demo not-content">
  <div class="frame">
    <div class="titlebar" aria-hidden="true">
      <span class="lights"><i></i><i></i><i></i></span>
      <span class="title">~/code/api</span>
    </div>
    <LiveRemote cols={80} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .remote-demo {
    margin: 1.5rem 0;
  }

  .frame {
    overflow: hidden;
    border: 1px solid #253235;
    border-radius: 0.625rem;
    background: #141414;
    box-shadow: 0 1.25rem 3.125rem -0.625rem rgb(0 0 0 / 30%);
  }

  .titlebar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.75rem;
    border-bottom: 1px solid #222;
    background: #1b1b1b;
  }

  .lights {
    position: absolute;
    left: 0.625rem;
    display: flex;
    gap: 0.375rem;
  }

  .lights i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: #ff5f57;
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  .title {
    color: #8a8a8a;
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    line-height: 1;
  }

  :global(:root[data-theme='light']) .frame {
    border-color: #d8e2de;
    background: #fbfbfa;
    box-shadow: 0 1.25rem 3.125rem -1.25rem rgb(16 32 30 / 25%);
  }

  :global(:root[data-theme='light']) .titlebar {
    border-bottom-color: #e2e2e0;
    background: #efefed;
  }

  :global(:root[data-theme='light']) .title {
    color: #6b6b6b;
  }

  figcaption {
    padding-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    text-align: center;
  }
</style>
